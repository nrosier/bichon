{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "cargo dependencies"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["reqwest", "argon2", "oauth2"],
      "matchUpdateTypes": ["major"],
      "groupName": "cargo security-sensitive major updates",
      "description": "reqwest/argon2/oauth2 major bumps tend to break compilation or change password-hashing behavior; keep them out of the routine cargo group so one breaking bump doesn't block everything else."
    },
    {
      "matchManagers": ["npm"],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
